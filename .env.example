# Copy to .env for local runs. Never commit .env.

# local | prod
ENV=local
# static (local demo login, hint shown) | basic (Cloud Run: your own APP_USER/APP_PASSWORD)
AUTH_MODE=static
# mock (fake data, no API calls) | real (Google Ads API)
ADS_BACKEND=mock
# Real writes to Google Ads are OFF unless this is true.
ALLOW_MUTATE=false

# Static login (local only)
APP_USER=demo
APP_PASSWORD=pmax@user@2026

# Session signing key. If empty a random one is generated per start.
SECRET_KEY=

# Deployment / tenant access control (per deployment, e.g. per client GCP project)
ORG_NAME=Local
ADMIN_EMAILS=demo@local   # prod: jakaria.ahmed@wppmedia.com
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Real backend, local dev only: path to a google-ads.yaml (kept outside git)
GOOGLE_ADS_YAML_PATH=../google-ads.yaml

# --- Cloud Run only (AUTH_MODE=basic, ENV=prod). Put secrets in Secret Manager, not here. ---
# SECRET_KEY=<long random string>      APP_PASSWORD=<12+ chars>     ADMIN_EMAILS=you@company.com
# Per-user consent (each user connects their own Google Ads): ADS_ACCESS=user
#   needs GOOGLE_ADS_DEVELOPER_TOKEN + a Web OAuth client (GOOGLE_ADS_CLIENT_ID/SECRET), see DEPLOY.md
# ADS_ACCESS=shared (default) uses one fixed identity instead (needs the refresh token too):
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REFRESH_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=        # optional MCC id (shared mode)
# OAUTH_REDIRECT_URI=https://<host>/oauth/callback
